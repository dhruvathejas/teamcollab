{
  "name": "teamcollab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "dotenv --no-expand -e .env.local -- prisma migrate dev",
    "postinstall": "prisma generate",
    "db:deploy": "dotenv --no-expand -e .env.local -- prisma migrate deploy",
    "db:studio": "dotenv --no-expand -e .env.local -- prisma studio",
    "db:local": "prisma dev --name teamcollab"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24"
  }
}

# Copy to .env.local and fill in. (.env.local is git-ignored; Next.js and the
# npm db:* scripts both read it.)

# SQLite database file (relative to prisma/). Use a postgresql:// URL in production
# after changing the provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Secret used to sign session tokens and hash one-time codes.
# Generate one with: npx auth secret
AUTH_SECRET=""

# Needed when running `next start` outside Vercel (or set AUTH_URL to your site URL).
AUTH_TRUST_HOST=true

# --- Email (two-factor codes) via Resend: https://resend.com/api-keys ---
RESEND_API_KEY=""
# Sender. Must be on a domain verified in Resend. For quick testing you can use
# "teamcollab <onboarding@resend.dev>", which only delivers to your own Resend
# account's email address.
EMAIL_FROM="teamcollab <onboarding@resend.dev>"
# Set to "console" to print codes to the server log instead of sending email
# (the default in development when RESEND_API_KEY is empty).
EMAIL_TRANSPORT=""

# Max code emails per hour across the whole app (protects your Resend quota).
EMAIL_HOURLY_LIMIT=300

# Where uploaded team files are stored on disk.
STORAGE_DIR="storage"
